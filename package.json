{
  "name": "estate-management-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file-if-exists=.env.local server.mjs",
    "start": "node --env-file-if-exists=.env.local server.mjs",
    "build": "npm run seo:generate && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "seo:generate": "node scripts/generate-seo.mjs",
    "smtp:verify": "node --env-file=.env.local scripts/verify-smtp.mjs",
    "studio:dev": "npm --prefix studio run dev",
    "studio:build": "npm --prefix studio run build",
    "studio:deploy": "npm --prefix studio run deploy"
  },
  "dependencies": {
    "@fontsource/kaushan-script": "^5.3.0",
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/client": "^8.7.0",
    "@vitejs/plugin-react": "latest",
    "express": "^5.2.1",
    "nodemailer": "^10.0.10",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.18.4",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "postcss": "latest",
    "tailwindcss": "^3.4.17",
    "typescript-eslint": "latest"
  }
}
